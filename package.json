  "license": "MIT",
  "dependencies": {
    "@toast-ui/editor": "3.2.2",
    "@toast-ui/editor-plugin-code-syntax-highlight": "3.1.0",
    "bootstrap": "4.6.2",
    "bootstrap-icons": "1.11.3",
    "mitt": "3.0.1",
    "mousetrap": "1.6.5",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@types/mousetrap": "1.6.15",
    "@types/node": "20.12.12",
    "@vitejs/plugin-vue": "5.0.4",
    "sass": "1.77.1",
    "typescript": "5.4.5",
    "vite": "5.2.11",
