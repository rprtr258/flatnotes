{
  "name": "flatnotes",
  "version": "3.3.0",
  "description": "A database-less note taking web app that utilises a flat folder of markdown files for storage.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
